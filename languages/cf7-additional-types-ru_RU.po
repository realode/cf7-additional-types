#. Plugin Name of the plugin
#: cf7-additional-types.php
msgid "CF7 Additional Types"
msgstr "CF7 Дополнительные типы"

#. Plugin URI of the plugin
#: cf7-additional-types.php
msgid "https://github.com/meostudio/cf7-additional-types"
msgstr ""

#. Description of the plugin
#: cf7-additional-types.php
msgid "Design Contact Form 7 forms right in the block editor, and add a range slider, date picker and time picker to your forms."
msgstr "Оформляйте формы Contact Form 7 прямо в редакторе блоков и добавляйте в них ползунок, выбор даты и выбор времени."

#. Author of the plugin
#: cf7-additional-types.php
msgid "Janis Freimann, meo.studio"
msgstr ""

#. Author URI of the plugin
#: cf7-additional-types.php
msgid "https://janfrei.me/"
msgstr ""

#: includes/Fields/Date_Picker.php:46
msgid "date picker"
msgstr "выбор даты"

#: includes/Fields/Date_Picker.php:47
msgid "Date picker"
msgstr "Выбор даты"

#: includes/Fields/Date_Picker.php:48
msgid "Date picker form-tag generator"
msgstr "Генератор тега формы: выбор даты"

#: includes/Fields/Date_Picker.php:49
msgid "Generates a form-tag for a date field with a calendar that follows the site language and week start."
msgstr "Создаёт тег формы для поля даты с календарём, который учитывает язык сайта и первый день недели."

#: includes/Fields/Date_Picker.php:247
msgid "Date picker value is not a valid date"
msgstr "Значение поля выбора даты не является корректной датой"

#: includes/Fields/Date_Picker.php:248
msgid "Please choose a valid date."
msgstr "Выберите корректную дату."

#: includes/Fields/Date_Picker.php:251
msgid "Date picker value falls on a day that cannot be chosen"
msgstr "Выбранная дата приходится на недоступный день"

#: includes/Fields/Date_Picker.php:252
msgid "This day is not available. Please choose another date."
msgstr "Этот день недоступен. Выберите другую дату."

#: includes/Fields/Date_Picker.php:279
msgid "A date (YYYY-MM-DD) or a relative date such as today, +1_week or -18_years."
msgstr "Дата (ГГГГ-ММ-ДД) или относительная дата, например today, +1_week или -18_years."

#: includes/Fields/Date_Picker.php:281
#: includes/Fields/Time_Picker.php:201
msgid "Range"
msgstr "Диапазон"

#: includes/Fields/Date_Picker.php:285
#: includes/Fields/Time_Picker.php:205
msgid "Earliest"
msgstr "Не раньше"

#: includes/Fields/Date_Picker.php:286
#: includes/Fields/Time_Picker.php:206
msgid "Latest"
msgstr "Не позже"

#: includes/Fields/Date_Picker.php:302
msgid "Available days"
msgstr "Доступные дни"

#: includes/Fields/Date_Picker.php:304
msgid "Weekdays only (no Saturdays or Sundays)."
msgstr "Только будние дни (без суббот и воскресений)."

#: includes/Fields/Picker_Field.php:130
msgid "Default value"
msgstr "Значение по умолчанию"

#: includes/Fields/Picker_Field.php:131
msgid "Use this text as the placeholder."
msgstr "Использовать этот текст в качестве заполнителя."

#: includes/Fields/Range_Slider.php:49
msgid "range slider"
msgstr "ползунок"

#: includes/Fields/Range_Slider.php:50
msgid "Range slider"
msgstr "Ползунок"

#: includes/Fields/Range_Slider.php:51
msgid "Range slider form-tag generator"
msgstr "Генератор тега формы: ползунок"

#: includes/Fields/Range_Slider.php:52
msgid "Generates a form-tag for a slider. Enter step labels for a slider with named steps, or leave them empty for a numeric slider."
msgstr "Создаёт тег формы для ползунка. Укажите подписи шагов для ползунка с именованными шагами или оставьте поле пустым для числового ползунка."

#: includes/Fields/Range_Slider.php:343
msgid "Range slider value is not one of its steps"
msgstr "Значение ползунка не соответствует ни одному из его шагов"

#: includes/Fields/Range_Slider.php:344
msgid "Please choose one of the available options."
msgstr "Выберите один из доступных вариантов."

#: includes/Fields/Range_Slider.php:374
msgid "Step labels"
msgstr "Подписи шагов"

#: includes/Fields/Range_Slider.php:376
msgid "One label per line. Leave empty for a numeric slider."
msgstr "Одна подпись на строку. Оставьте пустым для числового ползунка."

#: includes/Fields/Range_Slider.php:381
msgid "Default"
msgstr "По умолчанию"

#: includes/Fields/Range_Slider.php:384
msgid "With labels: the position of the preselected label (1 = first). Without labels: the starting number."
msgstr "С подписями: номер подписи, выбранной по умолчанию (1 = первая). Без подписей: начальное значение."

#: includes/Fields/Range_Slider.php:389
msgid "Numeric range"
msgstr "Числовой диапазон"

#: includes/Fields/Range_Slider.php:393
msgid "Min"
msgstr "Мин."

#: includes/Fields/Range_Slider.php:394
msgid "Max"
msgstr "Макс."

#: includes/Fields/Range_Slider.php:395
msgid "Step"
msgstr "Шаг"

#: includes/Fields/Range_Slider.php:405
msgid "Only used when there are no step labels."
msgstr "Используется только без подписей шагов."

#: includes/Fields/Range_Slider.php:407
msgid "Number display"
msgstr "Отображение числа"

#: includes/Fields/Range_Slider.php:411
msgid "Currency"
msgstr "Валюта"

#: includes/Fields/Range_Slider.php:419
msgid "Prefix"
msgstr "Префикс"

#: includes/Fields/Range_Slider.php:420
msgid "Suffix"
msgstr "Суффикс"

#: includes/Fields/Range_Slider.php:431
msgid "Currency: a code such as EUR, USD or GBP, formatted for the site language. Prefix and suffix: plain text such as % or km, with an underscore for a space."
msgstr "Валюта: код, например EUR, USD или GBP, — значение форматируется по языку сайта. Префикс и суффикс: простой текст, например % или km; пробел обозначается подчёркиванием."

#: includes/Fields/Range_Slider.php:434
#: build/editor.js:1
msgid "Labels"
msgstr "Подписи"

#: includes/Fields/Range_Slider.php:436
msgid "Show the labels (or the min and max) under the slider."
msgstr "Показывать подписи (или минимум и максимум) под ползунком."

#: includes/Fields/Time_Picker.php:49
msgid "time picker"
msgstr "выбор времени"

#: includes/Fields/Time_Picker.php:50
msgid "Time picker"
msgstr "Выбор времени"

#: includes/Fields/Time_Picker.php:51
msgid "Time picker form-tag generator"
msgstr "Генератор тега формы: выбор времени"

#: includes/Fields/Time_Picker.php:52
msgid "Generates a form-tag for a time field with a list of times in the site’s time format."
msgstr "Создаёт тег формы для поля времени со списком значений в формате времени сайта."

#: includes/Fields/Time_Picker.php:162
msgid "Time picker value is not a valid time"
msgstr "Значение поля выбора времени не является корректным временем"

#: includes/Fields/Time_Picker.php:163
msgid "Please choose a valid time."
msgstr "Выберите корректное время."

#: includes/Fields/Time_Picker.php:166
msgid "Time is earlier than the time picker allows"
msgstr "Время раньше допустимого"

#: includes/Fields/Time_Picker.php:167
msgid "This time is too early."
msgstr "Это время слишком раннее."

#: includes/Fields/Time_Picker.php:170
msgid "Time is later than the time picker allows"
msgstr "Время позже допустимого"

#: includes/Fields/Time_Picker.php:171
msgid "This time is too late."
msgstr "Это время слишком позднее."

#: includes/Fields/Time_Picker.php:220
msgid "Interval"
msgstr "Интервал"

#: includes/Fields/Time_Picker.php:223
msgid "Minutes between the times in the list. Default: 30."
msgstr "Минуты между значениями в списке. По умолчанию: 30."

#: includes/Fields/Time_Picker.php:231
msgid "A time in 24-hour format, e.g. 14:30."
msgstr "Время в 24-часовом формате, например 14:30."

#: includes/Plugin.php:150
msgid "Choose date"
msgstr "Выберите дату"

#: includes/Plugin.php:151
msgid "Choose time"
msgstr "Выберите время"

#: includes/Plugin.php:152
msgid "Clear"
msgstr "Очистить"

#: includes/Plugin.php:153
msgid "Previous month"
msgstr "Предыдущий месяц"

#: includes/Plugin.php:154
msgid "Next month"
msgstr "Следующий месяц"

#: includes/Plugin.php:155
msgid "Month"
msgstr "Месяц"

#: includes/Plugin.php:156
msgid "Year"
msgstr "Год"

#. translators: %s: minimum Contact Form 7 version number.
#: includes/Plugin.php:201
#, php-format
msgid "CF7 Additional Types needs Contact Form 7 %s or newer. Please update Contact Form 7 to use its fields and form styles."
msgstr "Для CF7 Additional Types требуется Contact Form 7 версии %s или новее. Обновите Contact Form 7, чтобы использовать поля и стили форм."

